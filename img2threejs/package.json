{
  "name": "civic-threejs-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:spec": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-civic-spec.ps1",
    "generate:blockout": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-civic-factory.ps1 -PassId blockout -OutFile ./src/generated/civic-blockout.ts"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/three": "^0.179.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
