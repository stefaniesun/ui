{
  "name": "@ui-rebuild/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node ../../node_modules/vite/bin/vite.js build",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.geometry.config.ts",
    "typecheck": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit"
  },
  "dependencies": {
    "@ui-rebuild/workbench-contracts": "workspace:*",
    "@vitejs/plugin-vue": "6.0.1",
    "vite": "7.1.1",
    "vue": "3.5.18",
    "vue-tsc": "3.0.5"
  }
}
